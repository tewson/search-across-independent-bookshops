---
export const prerender = false;

import puppeteer from "puppeteer";
import bookUpstairs from "../scrapers/book-upstairs";
import chapters from "../scrapers/chapters";
import companyOfBooks from "../scrapers/company-of-books";

const BOOK_UPSTAIRS = "Book Upstairs";
const CHAPTERS = "Chapters Bookstore";
const COMPANY_OF_BOOKS = "Company of Books";

interface Results {
  [store: string]:
    | {
        title: string;
        href: string;
      }
    | undefined;
}

const results: Results = {};

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  const browser = await puppeteer.launch();
  const page = await browser.newPage();

  const searchQuery = data.get("search")?.toString();

  if (searchQuery) {
    // Book Upstairs
    results[BOOK_UPSTAIRS] = await bookUpstairs(page, searchQuery);

    // Chapters
    results[CHAPTERS] = await chapters(page, searchQuery);

    // Company of Books
    results[COMPANY_OF_BOOKS] = await companyOfBooks(page, searchQuery);
  }

  await browser.close();
}
---

<div><a href="/">Home</a></div>

<h1>{BOOK_UPSTAIRS}</h1>
{
  results[BOOK_UPSTAIRS] ? (
    <a href={results[BOOK_UPSTAIRS].href}>{results[BOOK_UPSTAIRS].title}</a>
  ) : (
    <div>Not found</div>
  )
}

<h1>{CHAPTERS}</h1>
{
  results[CHAPTERS] ? (
    <a href={`https://chaptersbookstore.com${results[CHAPTERS].href}`}>
      {results[CHAPTERS].title}
    </a>
  ) : (
    <div>Not found</div>
  )
}

<h1>{COMPANY_OF_BOOKS}</h1>
{
  results[COMPANY_OF_BOOKS] ? (
    <a href={`https://thecompanyofbooks.ie${results[COMPANY_OF_BOOKS].href}`}>
      {results[COMPANY_OF_BOOKS].title}
    </a>
  ) : (
    <div>Not found</div>
  )
}
